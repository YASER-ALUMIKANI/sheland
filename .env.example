# Sheland Marketplace Environment Configuration Template
# Copy this file to .env and replace with your secure production values.

PORT=8000
ENVIRONMENT=production

# Generate secure 64-character hex keys for JWT signing:
# Python command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECURE_DYNAMIC_SECRET_KEY_HERE
JWT_SECRET_KEY=YOUR_SECURE_DYNAMIC_SECRET_KEY_HERE

# Allowed origins for CORS (comma-separated):
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://sheland.com
